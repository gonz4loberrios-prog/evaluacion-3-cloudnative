# Copiar a .env:  cp .env.example .env   (Windows: copy .env.example .env)
# Valores de DEMO. No incluir credenciales reales ni datos personales.

# --- Kafka ---
KAFKA_BOOTSTRAP_INTERNAL=kafka-1:29092,kafka-2:29092
KAFKA_BOOTSTRAP_HOST=localhost:9092,localhost:9093

# --- Kafka Streams ---
APPLICATION_ID=ventas-streams-dsy1107
TOPIC_RAW=ventas-raw
TOPIC_AGG=ventas-agregadas
TOPIC_DLQ=ventas-raw-dlq
WINDOW_MS=60000
GRACE_MS=30000
DEDUP_RETENTION_MS=86400000
NUM_STREAM_THREADS=2
STATE_DIR=/tmp/kafka-streams

# --- Métricas / monitorización ---
METRICS_PORT=8081
METRICS_HOST_PORT=18081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
KAFKA_EXPORTER_PORT=9308
# Las credenciales de Grafana NO se guardan aquí.
# Se usan los valores demo por defecto definidos en docker-compose.yml.
